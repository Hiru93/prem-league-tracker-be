# Copy to .env and fill in real values locally. Never commit .env.
# See docs/hosting-deployment-be-technical.md and docs/security-technical.md.

# Postgres — local Docker container in dev, Neon in preview/production (injected by Vercel's marketplace integration there)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prem_league_tracker?schema=public"

# Node environment
NODE_ENV="development"

# CORS — the frontend origin allowed to call this API (security-technical.md)
CORS_ORIGIN="http://localhost:5173"

# Auth (security-technical.md)
ADMIN_JWT_SECRET="replace-with-a-long-random-string"
CREDENTIALS_ENCRYPTION_KEY="replace-with-a-32-byte-base64-key"
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_INITIAL_PASSWORD=""

# Redis — local Docker container in dev; Upstash REST vars in preview/production
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Scryfall (scryfall-integration-technical.md)
SCRYFALL_API_BASE_URL="https://api.scryfall.com"
SCRYFALL_CACHE_SOFT_TTL_DAYS="30"
SCRYFALL_CACHE_HARD_TTL_DAYS="60"
SCRYFALL_MIN_REQUEST_INTERVAL_MS="75"
SCRYFALL_MAX_RETRIES="3"

# Scoring (league-scoring-technical.md)
SCORING_BASE_POINTS="100"

# melee.gg mock mode override (melee-integration-technical.md §5) — force mock mode even if a league has credentials configured
MELEE_MOCK_MODE="false"
